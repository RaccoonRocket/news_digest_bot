[Unit]
Description=Personal Telegram news digest
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=newsdigest
WorkingDirectory=/opt/news_digest_bot
ExecStart=/opt/news_digest_bot/.venv/bin/python -m bot
Restart=always
RestartSec=5s
TimeoutStopSec=180s
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
